# Copy these into Vercel → Project → Settings → Environment Variables.
# Never commit real values; .env is gitignored.
#
# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The SERVICE ROLE key, not the anon key. It bypasses row level security, so it
# is server-only and must never reach the browser. Vercel keeps it server-side
# for anything under /api as long as the name has no NEXT_PUBLIC_/VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# ── The prize rail ─────────────────────────────────────────────────────────
# The wallet prizes are paid FROM. Its balance is read off the chain and shown
# in the game as the season purse, so this must be an address you control and
# top up. Leave it unset and the purse simply does not appear — the standings,
# the market and the game all carry on without it.
TREASURY_WALLET=
# Which asset the season pays out in: sol (default) or token.
PAYOUT_ASSET=sol
# The share of the treasury paid out each season. A pot that empties every
# season is a pot nobody trusts to be there next season.
PAYOUT_CUT=0.2
# How many folk a reign needs before it can place at all.
PAYOUT_MIN_POP=25
# Opens /admin — the paymaster page — and seals each payout list. There is no
# private key anywhere on the server, so this secret cannot move a coin; what it
# guards is the list, the CSV and the record of what was sent.
PAYOUT_SECRET=
